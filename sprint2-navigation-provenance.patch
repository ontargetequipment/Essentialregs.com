+  ('31', 'https://cdphe.colorado.gov/aqcc-regulations',
+   'https://www.sos.state.co.us/CCR/DisplayRule.do?action=ruleinfo&ruleId=3469&deptID=16&agencyID=7'),  -- 5 CCR 1001-35
