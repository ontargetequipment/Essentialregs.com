# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings → API). Both are safe to expose to the browser —
# access control is enforced by Row Level Security, not by secrecy of these
# values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin of the deployed site, no trailing slash. Used for absolute
# URLs in metadata, sitemap.xml, robots.txt, and Stripe success/cancel/return
# URLs. Defaults to https://www.essentialregs.com when unset; override on
# preview deployments.
NEXT_PUBLIC_SITE_URL=https://www.essentialregs.com

# --- Server-only secrets (never prefixed NEXT_PUBLIC_; never sent to the browser) ---
# Supabase service-role key (Project Settings → API). Bypasses RLS; used only by the Stripe webhook to update profiles.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Stripe secret key (Developers → API keys). Use sk_test_... locally and sk_live_... in production.
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret for the /api/stripe/webhook endpoint (Developers → Webhooks → your endpoint → Signing secret).
STRIPE_WEBHOOK_SECRET=whsec_...
# No Price ids here: the checkout finds the monthly and annual Prices by their
# lookup keys (src/lib/pricing.ts PRICE_LOOKUP). `npm run stripe:setup` reads
# STRIPE_SECRET_KEY from this file and creates them, the Customer Portal
# configuration and the webhook endpoint in whichever Stripe mode the key
# selects; it writes the ids (and a new webhook's secret) to stripe-setup.local.txt.
