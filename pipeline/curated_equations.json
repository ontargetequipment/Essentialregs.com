   "source": "GP12.pdf",
   "equations": [
    {
     "label": "",
     "html": "<var>Fuel Consumption</var><sub>engine</sub> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">MMSCF</span><span class=\"eq-den\">month</span></span><span class=\"eq-paren\">)</span> = <span class=\"eq-frac\"><span class=\"eq-num\"><var>Hours of operation</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">hrs</span><span class=\"eq-den\">month</span></span><span class=\"eq-paren\">)</span> × <var>BSFC</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">BTU</span><span class=\"eq-den\">hp hr</span></span><span class=\"eq-paren\">)</span> × <var>Site rated HP</var> (hp)</span><span class=\"eq-den\"><var>Fuel Gas Heat Content</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">BTU</span><span class=\"eq-den\">SCF</span></span><span class=\"eq-paren\">)</span> × 10<sup>6</sup> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">SCF</span><span class=\"eq-den\">MMSCF</span></span><span class=\"eq-paren\">)</span></span></span>",
     "text": "Fuel Consumption_engine (MMSCF/month) = [Hours of operation (hrs/month) × BSFC (BTU/hp hr) × Site rated HP (hp)] / [Fuel Gas Heat Content (BTU/SCF) × 10^6 (SCF/MMSCF)]"
    }
   ]
