   "source": "GP06.pdf",
   "equations": [
    {
     "label": "Eq. 1.a.",
     "html": "<var>Emission</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">ton</span><span class=\"eq-den\">year</span></span><span class=\"eq-paren\">)</span> = <var>EF</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">X lb</span><span class=\"eq-den\">10<sup>6</sup> Btu</span></span><span class=\"eq-paren\">)</span> ∗ <var>LHV</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">btu</span><span class=\"eq-den\">gal</span></span><span class=\"eq-paren\">)</span> ∗ <var>RunTime</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">hrs</span><span class=\"eq-den\">yr</span></span><span class=\"eq-paren\">)</span> ∗ <var>FuelUsage</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">gal</span><span class=\"eq-den\">hr</span></span><span class=\"eq-paren\">)</span> ∗ <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">1 ton</span><span class=\"eq-den\">2000 lb</span></span><span class=\"eq-paren\">)</span>",
     "text": "Emission (ton/year) = EF (X lb / 10^6 Btu) * LHV (btu/gal) * RunTime (hrs/yr) * FuelUsage (gal/hr) * (1 ton / 2000 lb)"
    },
    {
     "label": "Eq. 1.b.",
     "html": "<var>Emission</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">ton</span><span class=\"eq-den\">year</span></span><span class=\"eq-paren\">)</span> = <var>EF</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">X lb</span><span class=\"eq-den\">HP−hr</span></span><span class=\"eq-paren\">)</span> ∗ <var>HP</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">hp</span><span class=\"eq-den\">1</span></span><span class=\"eq-paren\">)</span> ∗ <var>RunTime</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">hrs</span><span class=\"eq-den\">yr</span></span><span class=\"eq-paren\">)</span> ∗ <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">1 ton</span><span class=\"eq-den\">2000 lb</span></span><span class=\"eq-paren\">)</span>",
     "text": "Emission (ton/year) = EF (X lb / HP-hr) * HP (hp/1) * RunTime (hrs/yr) * (1 ton / 2000 lb)"
    },
    {
     "label": "Eq. 1.c",
     "html": "<var>Emission</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">ton</span><span class=\"eq-den\">year</span></span><span class=\"eq-paren\">)</span> = <var>EF</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">X g</span><span class=\"eq-den\">HP−hr</span></span><span class=\"eq-paren\">)</span> ∗ <var>HP</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">hp</span><span class=\"eq-den\">1</span></span><span class=\"eq-paren\">)</span> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">0.0022lb</span><span class=\"eq-den\">g</span></span><span class=\"eq-paren\">)</span> ∗ <var>RunTime</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">hr</span><span class=\"eq-den\">yr</span></span><span class=\"eq-paren\">)</span> ∗ <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">1 ton</span><span class=\"eq-den\">2000 lb</span></span><span class=\"eq-paren\">)</span>",
     "text": "Emission (ton/year) = EF (X g / HP-hr) * HP (hp/1) (0.0022lb/g) * RunTime (hr/yr) * (1 ton / 2000 lb)"
    },
    {
     "label": "Eq. 1.d",
     "html": "<var>Emission</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">ton</span><span class=\"eq-den\">year</span></span><span class=\"eq-paren\">)</span> = <var>EF</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">X lb</span><span class=\"eq-den\">1000 gal</span></span><span class=\"eq-paren\">)</span> ∗ <var>RunTime</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">hr</span><span class=\"eq-den\">yr</span></span><span class=\"eq-paren\">)</span> ∗ <var>FuelRate</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">gal</span><span class=\"eq-den\">hr</span></span><span class=\"eq-paren\">)</span> ∗ <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">1 ton</span><span class=\"eq-den\">2000 lb</span></span><span class=\"eq-paren\">)</span>",
     "text": "Emission (ton/year) = EF (X lb / 1000 gal) * RunTime (hr/yr) * FuelRate (gal/hr) * (1 ton / 2000 lb)"
    },
    {
     "label": "Eq. 1.e",
     "html": "<var>Emission</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">ton</span><span class=\"eq-den\">year</span></span><span class=\"eq-paren\">)</span> = <var>EF</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">X g</span><span class=\"eq-den\">kw−hr</span></span><span class=\"eq-paren\">)</span> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">kw−hr</span><span class=\"eq-den\">1.341 hp−hr</span></span><span class=\"eq-paren\">)</span> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">HP</span><span class=\"eq-den\">1</span></span><span class=\"eq-paren\">)</span> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">0.0022lb</span><span class=\"eq-den\">g</span></span><span class=\"eq-paren\">)</span> ∗ <var>RunTime</var> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">hr</span><span class=\"eq-den\">yr</span></span><span class=\"eq-paren\">)</span> <span class=\"eq-paren\">(</span><span class=\"eq-frac\"><span class=\"eq-num\">1 ton</span><span class=\"eq-den\">2000 lb</span></span><span class=\"eq-paren\">)</span>",
