# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent scratch (dev-only harnesses, screenshots)
/scratch

# Claude agent worktrees (sandbox-only)
/.claude/

# pipeline (Python) -- see pipeline/README.md
pipeline/__pycache__/
pipeline/*.pyc
pipeline/failed.jsonl

# Cowork writes files it delivers into this folder inside the connected
# folder, which is this repo root. They are working docs, not source.
# Ignoring it also stops stale RUN_ME_*.sql copies accumulating alongside
# the canonical ones in supabase/migrations and docs/imports.
Claude outputs/

# reader harness fixtures: real corpus rows pulled from the database (see scripts/reader-harness.ts)
/scripts/fixtures/
