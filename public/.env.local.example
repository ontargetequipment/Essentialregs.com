# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings → API). Both are safe to expose to the browser —
# access control is enforced by Row Level Security, not by secrecy of these
# values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
